---
import Logo from '../components/Logo.astro'
---


<footer class="m-5 font-poppins xl:m-20 xl:p-20 md:mb-60 mb-40 xl:mb-30">
    <section class="mb-5 xl:flex xl:flex-row xl:justify-between xl:mb-10">
        <div class="flex flex-col items-center mb-5 xl:items-start">
            <Logo/>
            <h2 class="font-bold text-principal text-[40px] md:text-[80px] xl:text-[27px]">Maxwell</h2>
            <p class="text-center text-text md:text-[30px] xl:text-[20px] xl:text-start xl:whitespace-nowrap">We growing up your business to the international scale</p>
        </div>

        <hr class="border-t-2 border-background mb-5 xl:hidden ">

        <nav class="space-y-10 md:space-y-14 xl:flex xl:flex-row xl:items-start xl:justify-around xl:space-y-0 xl:space-x-20">
            <ul class="flex flex-col items-center space-y-2 md:space-y-6 xl:items-start xl:space-y-2">
                <li><h3 class="font-bold text-principal text-[20px] md:text-[40px] xl:text-[20px]">COMPANY</h3></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Blog</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Careers</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Pricing</a></li>
            </ul>
 
            <ul class="flex flex-col items-center space-y-2 md:space-y-6 xl:items-start xl:space-y-2 whitespace-nowrap ">
                <li><h3 class="font-bold text-principal text-[20px] md:text-[40px] xl:text-[20px]">RESOURCES</h3></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Documentation</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Papers</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Press Conferences</a></li>
            </ul>

            <ul class="flex flex-col items-center space-y-2 md:space-y-6 xl:items-start xl:space-y-2 whitespace-nowrap">
                <li><h3 class="font-bold text-principal text-[20px] md:text-[40px] xl:text-[20px]">LEGAL</h3></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Terms of Services</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Privacy Policy</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Cookies Policy</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Data Processing</a></li>
            </ul>
        </nav>
    </section>

    <hr class="border-t-2 border-background mb-5 ">

    <section class="flex flex-col xl:flex xl:flex-row xl:justify-between xl:items-center">
        <div class="mb-10 md:mb-12">
            <p class="text-center text-text md:text-[30px] xl:text-[16px]">©️ 2023 Maxwell Inc. All rights reserved.</p>
        </div>

        <div class="flex flex-row items-center justify-evenly mb-5 md:mb-10 xl:space-x-7">
            <img class="w-[40px] md:w-[80px] xl:w-[40px] xl:hover:animate-tada" src="/Proyecto-12-Footers-Lights/assets/instagram.svg" alt="Instagram">
            <img class="w-[40px] md:w-[80px] xl:w-[40px] xl:hover:animate-tada"  src="/Proyecto-12-Footers-Lights/assets/facebook.svg" alt="Facebook">
            <img class="w-[40px] md:w-[80px] xl:w-[40px] xl:hover:animate-tada"  src="/Proyecto-12-Footers-Lights/assets/youtube.svg" alt="Youtube">
        </div>
    </section>

</footer>
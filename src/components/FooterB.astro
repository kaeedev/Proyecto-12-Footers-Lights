---
import Logo from '../components/Logo.astro'
---


<footer class="m-5 font-poppins xl:m-20 xl:p-20">
    <section class="mb-5 xl:flex xl:flex-row xl:justify-between xl:mb-10">
        <div class="flex flex-col items-center mb-5 xl:items-start xl:max-w-[450px] md:mb-10">
            <Logo/>
            <h2 class="font-bold text-principal text-[40px] md:text-[80px] xl:text-[27px] md:text-center md:mb-5 xl:text-start text-center mb-5">We growing up your business with personal AI manager.</h2>
            <p class="text-center text-text md:text-[40px] xl:text-[20px] text-[20px]">Maxwell, 2023.</p>
        </div>

        <hr class="border-t-2 border-background mb-5 xl:hidden md:mb-10 ">

        <nav class="space-y-10 md:space-y-14 xl:flex xl:flex-row xl:items-start xl:justify-around xl:space-y-0 xl:space-x-20 whitespace-nowrap md:mb-10">
            <ul class="flex flex-col items-center space-y-2 md:space-y-6 xl:items-start xl:space-y-2">
                <li><h3 class=" text-text  text-[20px] md:text-[40px] xl:text-[20px]">Company</h3></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Blog</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Careers</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Pricing</a></li>
            </ul>
 
            <ul class="flex flex-col items-center space-y-2 md:space-y-6 xl:items-start xl:space-y-2 ">
                <li><h3 class=" text-text text-[20px] md:text-[40px] xl:text-[20px]">Resources</h3></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Documentation</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Papers</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Press Conferences</a></li>
            </ul>

            <ul class="flex flex-col items-center space-y-2 md:space-y-6 xl:items-start xl:space-y-2">
                <li><h3 class="text-text  text-[20px] md:text-[40px] xl:text-[20px]">Legal</h3></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Terms of Services</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Privacy Policy</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Cookies Policy</a></li>
                <li class="xl:hover:animate-squeeze"><a class="text-text md:text-[30px] xl:text-[18px]" href="#">Data Processing</a></li>
            </ul>

            <div class="xl:flex xl:flex-col xl:space-y-4 flex flex-col items-center md:space-y-6 xl:items-start space-y-4">
                <h3 class="text-text text-[20px] md:text-[40px] xl:text-[20px] whitespace-nowrap">Get the app</h3>

                <div class=" border border-principal rounded-3xl xl:p-2 md:p-6 p-4 hover:bg-background transition-colors duration-300 xl:hover:animate-squeeze">
                    <a class=" flex flex-row items-center text-text md:text-[30px] xl:text-[16px] md:gap-4 xl:gap-2 gap-2" href="#"><img class="md:w-[50px] xl:w-[20px]" src="/Proyecto-12-Footers-Lights/assets/windows.svg" alt="Information">Windows</a>
                </div>
                
                <div class="border border-principal rounded-3xl p-4 hover:bg-background transition-colors duration-300 xl:hover:animate-squeeze md:p-6 xl:p-2">
                    <a class=" flex flex-row items-center text-text md:text-[30px] xl:text-[16px] md:gap-4 xl:gap-2 gap-2" href="#"><img class=" xl:w-[20px] md:w-[50px]" src="/Proyecto-12-Footers-Lights/assets/macos.svg" alt="Information">macOs</a>
                </div>
            </div>
        </nav>
    </section>
    


    <section class="flex flex-col items-center xl:flex xl:flex-row xl:items-center bg-background xl:justify-around md:flex md:flex-row md:items-center md:justify-around xl:p-4 md:p-2 p-4 rounded-tr-2xl rounded-tl-2xl">

            <p class="text-text md:text-[30px] xl:text-[16px] xl:mb-0 xl:ml-2 md:mx-4 mb-5">
                ©️ 2023 Maxwell Inc. All rights reserved.
            </p>


        <div class=" flex flex-col items-center space-y-3 xl:flex xl:flex-row xl:justify-between xl:items-center xl:space-x-10 md:mx-4 md:flex md:flex-col md:items-center md:space-y-4 xl:space-y-0 md:p-4">
            <a class="text-text md:text-[30px] xl:text-[16px] xl:hover:animate-squeeze" href="#">Terms of Service</a>
            <a class="text-text md:text-[30px] xl:text-[16px] xl:hover:animate-squeeze" href="#"> Privacy Policy</a>
            <a class="text-text md:text-[30px] xl:text-[16px] xl:hover:animate-squeeze" href="#">Cookies</a>

        </div>
    </section>
    

</footer>